# ============================================================================
#  scrcpy-wireless-launcher 配置文件示例
# ----------------------------------------------------------------------------
#  这个文件是示例。实际使用的 config.ini 由 setup.bat / setup.sh 自动生成，
#  生成后你可以直接编辑它。
#
#  想手动创建？把本文件复制为 config.ini 并填入你的信息即可。
# ============================================================================

# 手机在局域网中的 IP 地址
# 查看方法：手机 设置 -> WLAN -> 点击当前网络 -> 查看 IP 地址
PHONE_IP=192.168.1.100

# adb 无线端口，默认 5555
# 若在 setup 时用了自定义端口（adb tcpip 47000），这里要同步修改
PORT=5555

# scrcpy 所在目录（留空则自动探测：本目录 -> PATH -> 常见安装位置）
SCRCPY_DIR=

# 传给 scrcpy 的额外参数
# ----------------------------------------------------------------------------
# 想要手机声音？删掉 --no-audio（需 Android 11+）
# EXTRA_ARGS=
#
# 更高画质
# EXTRA_ARGS=--no-audio --max-size=1920 --video-bit-rate=8M
#
# 低延迟（游戏场景）
# EXTRA_ARGS=--no-audio --max-size=1024 --max-fps=60 --video-bit-rate=4M
#
# 保持屏幕常亮
# EXTRA_ARGS=--no-audio --stay-awake
#
# 投屏时关闭手机屏幕（省电）
# EXTRA_ARGS=--no-audio --turn-screen-off
# ----------------------------------------------------------------------------
EXTRA_ARGS=--no-audio
